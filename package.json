{
  "name": "ccoop-platform",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "dev:web": "next dev apps/web -H 0.0.0.0",
    "db:seed": "node --env-file-if-exists=.env --import tsx packages/db/seed.ts",
    "worker": "node --env-file-if-exists=.env --import tsx apps/api/src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism tests/domain.test.ts tests/api.test.ts tests/cashfree.test.ts tests/migration.test.ts tests/payment-isolation.test.ts tests/campaigns.test.ts",
    "test:native": "vitest run --no-file-parallelism tests/native.test.ts",
    "test:e2e": "playwright test",
    "build": "next build apps/web"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "bullmq": "^6.4.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "ioredis": "^6.0.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "workspaces": [
    "apps/*"
  ]
}
