DATABASE_URL=postgres://ccoop:ccoop@127.0.0.1:5432/ccoop
REDIS_URL=redis://127.0.0.1:6379
APP_ORIGIN=http://localhost:3000
PAYMENT_MODE=simulator
DEV_AUTH=true
# Copy this file to .env; npm scripts load it through tsx --env-file.
# Razorpay mode accepts only rzp_test_ keys. Never put secrets in NEXT_PUBLIC variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
S3_ENDPOINT=
S3_BUCKET=
