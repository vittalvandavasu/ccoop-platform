DATABASE_URL=postgres://ccoop:ccoop@127.0.0.1:5432/ccoop
REDIS_URL=redis://127.0.0.1:6379
APP_ORIGIN=http://localhost:3000
PAYMENT_PROVIDER=cashfree
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
DEV_AUTH=true
# Copy to ignored .env. Never put secrets in NEXT_PUBLIC variables or GitHub workflow YAML.
# Use PAYMENT_PROVIDER=simulator for isolated local tests without provider credentials.
# Optional legacy Razorpay test records/webhooks; live keys are rejected.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
S3_ENDPOINT=
S3_BUCKET=
